<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Analysis-only contracts are omitted from compiled assemblies and runtime dependencies. -->
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" IncludeAssets="compile;build;analyzers" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

</Project>
