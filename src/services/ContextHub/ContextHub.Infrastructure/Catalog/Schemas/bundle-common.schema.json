{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 8192},
    "packageId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128},
    "packageCapability": {"enum": ["api_review", "api_implementation", "slide_authoring", "spreadsheet_editing", "document_editing", "research_verification"]},
    "clientCapability": {"enum": ["workspace_read", "workspace_write", "command_execution", "independent_reviewer", "presentation_edit", "spreadsheet_edit"]},
    "textList": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "inputs": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "description", "required"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 64}, "description": {"$ref": "#/$defs/text"}, "required": {"type": "boolean"}}}},
    "outputs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "description"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 64}, "description": {"$ref": "#/$defs/text"}}}},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["default_scope", "checks", "broaden_when"],
      "properties": {
        "default_scope": {"const": "affected"},
        "checks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "kind", "applies_when", "scope_guidance", "pass_criteria", "evidence_required"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
            "kind": {"type": "string", "enum": ["test", "inspection", "contract", "calculation", "source_check"]},
            "applies_when": {"$ref": "#/$defs/text"},
            "scope_guidance": {"$ref": "#/$defs/text"},
            "pass_criteria": {"$ref": "#/$defs/text"},
            "evidence_required": {"$ref": "#/$defs/text"}
          }
        }},
        "broaden_when": {"$ref": "#/$defs/textList"}
      }
    }
  }
}
