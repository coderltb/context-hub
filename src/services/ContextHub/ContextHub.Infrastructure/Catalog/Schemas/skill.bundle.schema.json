{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "when_to_use", "when_not_to_use", "inputs", "outputs", "instructions", "completion_criteria", "verification", "steps", "examples", "common_failures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "when_to_use": {"$ref": "bundle-common.schema.json#/$defs/text"},
    "when_not_to_use": {"$ref": "bundle-common.schema.json#/$defs/text"},
    "inputs": {"$ref": "bundle-common.schema.json#/$defs/inputs"},
    "outputs": {"$ref": "bundle-common.schema.json#/$defs/outputs"},
    "instructions": {"$ref": "bundle-common.schema.json#/$defs/text"},
    "completion_criteria": {"$ref": "bundle-common.schema.json#/$defs/textList"},
    "verification": {"$ref": "bundle-common.schema.json#/$defs/verification"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "instruction", "verification"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "instruction": {"$ref": "bundle-common.schema.json#/$defs/text"}, "verification": {"$ref": "bundle-common.schema.json#/$defs/text"}}}},
    "examples": {"$ref": "bundle-common.schema.json#/$defs/textList"},
    "common_failures": {"$ref": "bundle-common.schema.json#/$defs/textList"}
  }
}
