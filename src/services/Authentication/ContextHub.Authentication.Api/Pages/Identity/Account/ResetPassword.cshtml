@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<h1>Choose a new password</h1>
<p>After resetting your password, sign in again with your username and new password.</p>

<form class="sso-form" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-field">
        <label asp-for="Input.Password">New password</label>
        <input asp-for="Input.Password" autocomplete="new-password" autofocus
               aria-describedby="Input_Password-error"
               aria-invalid="@(ViewData.ModelState["Input.Password"]?.Errors.Count > 0 ? "true" : "false")" />
        <span asp-validation-for="Input.Password" id="Input_Password-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="Input.ConfirmPassword">Confirm password</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password"
               aria-describedby="Input_ConfirmPassword-error"
               aria-invalid="@(ViewData.ModelState["Input.ConfirmPassword"]?.Errors.Count > 0 ? "true" : "false")" />
        <span asp-validation-for="Input.ConfirmPassword" id="Input_ConfirmPassword-error"></span>
    </div>
    <button type="submit">Reset password</button>
</form>
