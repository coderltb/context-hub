@page
@model VerifyPasswordResetOtpModel
@{
    ViewData["Title"] = "Verify email code";
}
<h1>Check your email</h1>
<p>@AuthenticationRecoveryConstants.GENERIC_REQUEST_MESSAGE</p>

<form class="sso-form" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-field">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" autocomplete="email"
               aria-describedby="Input_Email-error"
               aria-invalid="@(ViewData.ModelState["Input.Email"]?.Errors.Count > 0 ? "true" : "false")" />
        <span asp-validation-for="Input.Email" id="Input_Email-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="Input.OtpCode">Six-digit code</label>
        <input asp-for="Input.OtpCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus
               aria-describedby="Input_OtpCode-error"
               aria-invalid="@(ViewData.ModelState["Input.OtpCode"]?.Errors.Count > 0 ? "true" : "false")" />
        <span asp-validation-for="Input.OtpCode" id="Input_OtpCode-error"></span>
    </div>
    <button type="submit">Verify code</button>
    <button class="sso-secondary" type="submit" asp-page="@SsoPageConstants.FORGOT_PAGE">Request another code</button>

</form>

<p>Requests are limited. The same code may remain valid when requested again.</p>
