@page
@model LogoutModel
@{
    ViewData["Title"] = "Sign out";
}
<h1>Sign out</h1>

<p>Only this browser's current Owner session will be ended. Client tokens are independent.</p>

<form class="sso-form" method="post" asp-controller="Authorization" asp-action="LogoutConfirmed">
    <input type="hidden" name="client_id" value="@Model.ClientId" />
    <input type="hidden" name="id_token_hint" value="@Model.IdTokenHint" />
    <input type="hidden" name="post_logout_redirect_uri" value="@Model.PostLogoutRedirectUri" />
    <input type="hidden" name="state" value="@Model.State" />
    <button type="submit">Sign out</button>
</form>
