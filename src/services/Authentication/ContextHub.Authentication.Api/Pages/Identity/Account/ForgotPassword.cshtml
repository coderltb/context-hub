@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
}
<h1>Reset password</h1>
<p>Enter your account email. If the account is eligible, we will send a code to help you set a new password.</p>

<form class="sso-form" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-field">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" autocomplete="email" autofocus
               aria-describedby="Input_Email-error"
               aria-invalid="@(ViewData.ModelState["Input.Email"]?.Errors.Count > 0 ? "true" : "false")" />
        <span asp-validation-for="Input.Email" id="Input_Email-error"></span>
    </div>
    <button type="submit">Send code</button>
    <a asp-page="@SsoPageConstants.LOGIN_PAGE" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>
</form>
