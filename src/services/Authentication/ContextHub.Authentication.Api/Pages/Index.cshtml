@page
@model ContextHub.Authentication.Api.Pages.IndexModel
@{
    ViewData["Title"] = "Single sign-on";
}
<h1>Single sign-on</h1>
@if (Model.IsSignedIn)
{
    <p>You are signed in. Continue to your Console or end this browser session.</p>
    <nav class="sso-form" aria-label="Account">
        @if (Model.ConsoleUrl is not null)
        {
            <a href="@Model.ConsoleUrl">Go to Console</a>
        }
        <a asp-page="@SsoPageConstants.LOGOUT_PAGE">Sign out</a>
    </nav>
}
else
{
    <p>Sign in with your Owner username and password to continue.</p>
    <a asp-page="@SsoPageConstants.LOGIN_PAGE">Sign in</a>
}
