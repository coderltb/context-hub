{
  "Observability": {
    "Logging": {
      "ConsoleFormat": "CompactJson",
      "MinimumLevel": "Information",
      "MinimumLevelOverrides": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
