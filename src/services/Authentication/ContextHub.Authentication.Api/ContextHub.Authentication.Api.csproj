<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <UserSecretsId>ContextHub.Authentication.Api</UserSecretsId>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <!-- Local credentials stay available for development but never enter publish output. -->
        <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\shared\ContextHub.ApiCommon\ContextHub.ApiCommon.csproj" />
      <ProjectReference Include="..\..\..\shared\ContextHub.Observability\ContextHub.Observability.csproj" />
      <ProjectReference Include="..\ContextHub.Authentication.Infrastructure\ContextHub.Authentication.Infrastructure.csproj" />
    </ItemGroup>

</Project>
